---
import Base from "../layouts/Base.astro";
---

<Base title="Not found · Vincent Chee">
  <section data-side="build" class="bg-grid flex min-h-svh flex-col justify-end px-4 pt-28 pb-16 sm:px-8">
    <div class="mx-auto w-full max-w-7xl space-y-8">
      <p class="font-mono text-sm text-muted"><span class="text-accent">$</span> cd: no such file or directory</p>
      <h1 class="font-mono text-[clamp(5rem,22vw,16rem)] leading-[0.8] font-extrabold tracking-[-0.07em]">404</h1>
      <p class="font-serif text-3xl text-fg sm:text-5xl">This page doesn't exist.</p>
      <a href="/" class="inline-block font-mono text-sm text-accent underline-offset-4 hover:underline">← back home</a>
    </div>
  </section>
</Base>
