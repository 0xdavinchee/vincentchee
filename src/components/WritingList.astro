---
import { getPosts, formatDate } from "../lib/posts";

const posts = await getPosts();
---

<ol class="divide-y divide-line border-y border-line">
  {
    posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`} class="group grid gap-x-10 gap-y-2 py-8 sm:grid-cols-[13rem_1fr]">
          <span class="font-mono text-xs text-muted sm:pt-2">{formatDate(post.data.publishedAt)}</span>
          <span class="space-y-2">
            <span class="block font-serif text-2xl leading-tight underline-offset-[0.2em] group-hover:underline sm:text-3xl">
              {post.data.title}
            </span>
            <span class="block max-w-2xl text-sm leading-relaxed text-muted">{post.data.description}</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>
