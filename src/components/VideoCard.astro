---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Video } from "../data/profile";

interface Props {
  video: Video;
}
const { video } = Astro.props;

const thumbs = import.meta.glob<{ default: ImageMetadata }>("../assets/videos/*.jpg", { eager: true });
const thumb = thumbs[`../assets/videos/${video.thumb}`]?.default;
if (!thumb) throw new Error(`Missing thumbnail for video ${video.id}: ${video.thumb}`);
---

<a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer" class="group block space-y-3">
  <Image
    src={thumb}
    alt=""
    widths={[320, 640]}
    sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 100vw"
    class="aspect-video w-full rounded-sm object-cover transition-opacity group-hover:opacity-85"
    loading="lazy"
  />
  <p class="font-serif text-lg leading-snug underline-offset-4 group-hover:underline">{video.title}</p>
  <p class="text-xs text-muted">{video.views} views</p>
</a>
