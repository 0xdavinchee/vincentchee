---
interface Props {
  id: string;
  zh: string;
  class?: string;
}
const { id, zh, class: className } = Astro.props;
---

<h2 id={id} class:list={["font-serif text-[clamp(2.4rem,6.5vw,5rem)] leading-[0.98] font-medium tracking-[-0.02em]", className]}>
  <span lang="zh-Hant" class="mr-[0.25em] font-kai text-[0.86em] font-bold text-accent">{zh}</span><slot />
</h2>
