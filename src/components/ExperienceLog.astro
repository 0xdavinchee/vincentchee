---
import { duration, formatYm, roles } from "../data/profile";
---

<ol class="divide-y divide-line border-y border-line">
  {
    roles.map((r) => (
      <li class="grid gap-x-10 gap-y-3 py-8 sm:grid-cols-[13rem_1fr]">
        <div class="space-y-1 text-sm text-muted">
          <p class="font-mono text-xs">
            {formatYm(r.start)} – {formatYm(r.end)}
          </p>
          <p class="font-mono text-xs">{duration(r.start, r.end)}</p>
          <p>{r.location}</p>
        </div>
        <div class="max-w-3xl space-y-3">
          <h3 class="text-xl font-semibold tracking-tight">
            {r.url ? (
              <a href={r.url} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:underline">
                {r.company}
              </a>
            ) : (
              r.company
            )}
            <span class="font-normal text-muted"> · {r.title}</span>
          </h3>
          <ul class="list-disc space-y-1.5 pl-5 text-[0.95rem] leading-relaxed text-fg/85 marker:text-muted">
            {r.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          {r.stack && <p class="font-mono text-xs text-muted">{r.stack.join(" · ")}</p>}
        </div>
      </li>
    ))
  }
</ol>
