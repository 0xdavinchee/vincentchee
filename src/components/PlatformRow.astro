---
import { socials } from "../data/profile";

const platforms = socials.filter((s) => s.side === "create");
---

<ul class="border-t border-navy">
  {
    platforms.map((p) => (
      <li class="border-b border-navy">
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flood group flex items-baseline justify-between gap-4 px-2 py-4 sm:px-3"
        >
          <span class="font-serif text-3xl italic sm:text-4xl">{p.label}</span>
          <span class="flood-muted font-mono text-xs text-muted">
            @{p.handle} <span aria-hidden="true">↗</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
