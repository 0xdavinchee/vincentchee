---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import VideoCard from "./VideoCard.astro";
import { createIntro, socials, standup, videos, youtube } from "../data/profile";
import portrait from "../assets/portrait.png";

const platforms = socials.filter((s) => s.side === "create");
---

<section id="create" data-side="create" aria-labelledby="create-title" class="scroll-mt-12 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl space-y-20 px-4 sm:space-y-24 sm:px-8">
    <div class="grid items-end gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <Image
        src={portrait}
        alt="Vincent on a terrace above a turquoise bay lined with palms and green hills"
        widths={[400, 720]}
        sizes="(min-width: 1024px) 440px, 100vw"
        class="aspect-[4/5] w-full max-w-md rounded-sm object-cover object-[48%_center]"
      />
      <div class="space-y-8">
        <SectionHeading id="create-title" zh="創作">Collecting <em>experiences</em>.</SectionHeading>
        <p class="max-w-2xl font-serif text-2xl leading-snug sm:text-3xl">{createIntro}</p>
        <p class="text-muted">
          {youtube.videos} videos and {youtube.subscribers} subscribers on YouTube so far. Also on{" "}
          {
            platforms
              .filter((p) => p.label !== "YouTube")
              .map((p, i, arr) => (
                <>
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-fg underline underline-offset-4 hover:text-accent-text">
                    {p.label}
                  </a>
                  {i < arr.length - 1 ? " and " : "."}
                </>
              ))
          }
        </p>
      </div>
    </div>

    <div class="space-y-8">
      <div class="flex items-baseline justify-between gap-6 border-b border-line pb-4">
        <h3 class="font-serif text-3xl">Recent videos</h3>
        <a
          href="https://www.youtube.com/@itsdavinchee/videos"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 text-sm text-accent-text underline-offset-4 hover:underline">All on YouTube</a
        >
      </div>
      <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          videos.map((v) => (
            <li>
              <VideoCard video={v} />
            </li>
          ))
        }
      </ul>
    </div>

    <aside aria-label="Stand-up" class="grid gap-6 bg-royal p-8 text-paper sm:p-12 lg:grid-cols-2 lg:items-end">
      <p class="font-serif text-4xl leading-[1.05] sm:text-5xl">{standup.headline}</p>
      <p class="max-w-md leading-relaxed text-paper/90">{standup.body}</p>
    </aside>
  </div>
</section>
