---
import { identity, socials } from "../data/profile";

const nameSize = "text-[23vw] sm:text-[clamp(3.6rem,17.5vw,16rem)]";
---

<section aria-labelledby="hero-name" class="relative">
  <div data-side="build" class="bg-grid relative flex min-h-[40svh] flex-col justify-end overflow-hidden pt-24 sm:min-h-[52svh]">
    <div class="mx-auto flex w-full max-w-7xl items-start justify-between gap-6 px-4 text-sm sm:px-8 sm:text-base">
      <p class="rise text-muted" style="--i:0">AI-first engineer</p>
      <p class="rise text-right text-fg" style="--i:2">{identity.greeting}</p>
    </div>
    <div class="mx-auto w-full max-w-7xl px-3 sm:px-6">
      <h1
        id="hero-name"
        class:list={["rise -mb-[0.09em] font-mono leading-[0.8] font-bold tracking-[-0.06em] uppercase select-none", nameSize]}
        style="--i:1"
      >
        {identity.first}<span class="sr-only"> {identity.last}</span>
      </h1>
    </div>
  </div>

  <div data-side="create" class="relative overflow-hidden pb-14 sm:pb-20">
    <div class="mx-auto w-full max-w-7xl px-3 sm:px-6">
      <p
        aria-hidden="true"
        class:list={["rise pt-[0.04em] font-serif leading-[0.95] font-medium tracking-[-0.035em] text-vermilion italic select-none", nameSize]}
        style="--i:2"
      >
        {identity.last}<span class="text-navy not-italic">.</span>
      </p>
    </div>

    <div class="mx-auto mt-8 grid w-full max-w-7xl gap-8 px-4 sm:mt-10 sm:grid-cols-[1fr_auto] sm:items-end sm:px-8">
      <div class="rise space-y-4" style="--i:3" data-og-hide>
        <p class="max-w-[20ch] font-serif text-3xl leading-[1.05] sm:text-5xl">{identity.tagline}</p>
        <p class="text-muted">Now: <span class="text-fg">{identity.now}</span></p>
      </div>

      <ul class="rise flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted sm:justify-end" style="--i:4">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-fg hover:underline">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p
      aria-hidden="true"
      lang="zh-Hant"
      class="pointer-events-none absolute top-10 right-4 hidden font-kai text-2xl text-muted/70 [writing-mode:vertical-rl] lg:block"
    >
      {identity.chinese}
    </p>
  </div>
</section>
