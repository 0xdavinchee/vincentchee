---
import { identity, socials } from "../data/profile";

const year = new Date().getFullYear();
---

<footer id="contact" aria-labelledby="contact-title" class="scroll-mt-12">
  <div data-side="create" class="bg-grain py-24 sm:py-32">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-8">
      <p class="label">04 / say hi</p>
      <h2
        id="contact-title"
        class="font-serif text-[clamp(3.5rem,13vw,11rem)] leading-[0.85] font-medium tracking-[-0.04em]"
        style="font-variation-settings: 'opsz' 144"
      >
        Say <em class="text-tomato">hi</em>.
      </h2>
      <p class="max-w-xl text-lg leading-relaxed text-muted">
        Collabs, a weird idea, a restaurant I have to try, or something you want built. My inbox is open.
      </p>
      <a
        href={`mailto:${identity.email}`}
        class="inline-block font-serif text-[clamp(1.4rem,4.5vw,3rem)] break-all text-espresso underline decoration-tomato decoration-2 underline-offset-[0.2em] transition-colors hover:text-tomato-deep sm:break-normal"
      >
        {identity.email}
      </a>
    </div>
  </div>
  <div data-side="build" class="bg-grid">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-4 py-14 font-mono text-xs sm:grid-cols-[1fr_auto] sm:items-end sm:px-8"
    >
      <ul class="grid grid-cols-2 gap-x-10 gap-y-3 sm:grid-cols-3">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="group relative text-muted hover:text-fg">
                <span class="absolute -left-4 text-accent opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">
                  &gt;
                </span>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="space-y-1 text-muted sm:text-right">
        <p>{identity.languages.join(" · ")}</p>
        <p>© {year} {identity.name} · {identity.chinese}</p>
        <p>static, no trackers, built with Astro</p>
      </div>
    </div>
  </div>
</footer>
