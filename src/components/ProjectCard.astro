---
import type { Project } from "../data/profile";

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  href={project.url}
  target="_blank"
  rel="noopener noreferrer"
  class="flood group flex h-full flex-col justify-between gap-6 border border-line p-5 sm:p-6"
>
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-4">
      <h4 class="min-w-0 font-mono text-base font-semibold [overflow-wrap:anywhere]">{project.name}</h4>
      <span aria-hidden="true" class="font-mono transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
    </div>
    <p class="flood-muted text-sm leading-relaxed text-muted">{project.blurb}</p>
  </div>
  <div class="flood-muted flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.7rem] text-muted">
    {project.note && <span class="text-accent-text group-hover:text-inherit">{project.note}</span>}
    {project.tags.map((t) => <span>#{t}</span>)}
  </div>
</a>
