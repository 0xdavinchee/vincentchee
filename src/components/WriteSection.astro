---
import SectionHeading from "./SectionHeading.astro";
import WritingList from "./WritingList.astro";
import { elsewhereWriting } from "../data/profile";
---

<section id="write" data-side="write" aria-labelledby="write-title" class="scroll-mt-12 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl space-y-12 px-4 sm:px-8">
    <header class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <SectionHeading id="write-title" zh="文章">Writing.</SectionHeading>
      <p class="max-w-md text-muted lg:justify-self-end">
        Occasional long-form. Also on{" "}
        {
          elsewhereWriting.map((w, i) => (
            <>
              <a href={w.url} target="_blank" rel="noopener noreferrer" class="text-fg underline underline-offset-4 hover:text-accent">
                {w.label}
              </a>
              {i < elsewhereWriting.length - 2 ? ", " : i === elsewhereWriting.length - 2 ? " and " : "."}
            </>
          ))
        }
      </p>
    </header>
    <WritingList />
  </div>
</section>
