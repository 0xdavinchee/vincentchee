---
import SectionHeading from "./SectionHeading.astro";
import ExperienceLog from "./ExperienceLog.astro";
import { buildIntro, education, projects } from "../data/profile";
---

<section id="build" data-side="build" aria-labelledby="build-title" class="scroll-mt-12 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl space-y-16 px-4 sm:space-y-20 sm:px-8">
    <header class="grid gap-8 lg:grid-cols-2 lg:items-end">
      <SectionHeading id="build-title" zh="經歷">Fun builder.</SectionHeading>
      <div class="space-y-4">
        <p class="max-w-xl text-lg leading-relaxed text-fg/80">{buildIntro}</p>
        <p class="text-sm text-muted">
          {education.school}, {education.degree}, {education.years}
        </p>
      </div>
    </header>

    <ExperienceLog />

    <div class="space-y-6">
      <h3 class="font-serif text-3xl">Selected projects</h3>
      <ul class="grid gap-x-12 sm:grid-cols-2">
        {
          projects.map((p) => (
            <li class="border-t border-line py-5">
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="group block space-y-1.5">
                <p class="flex items-baseline justify-between gap-4">
                  <span class="font-medium underline-offset-4 group-hover:underline">{p.name}</span>
                  {p.note && <span class="shrink-0 font-mono text-xs text-accent-text">{p.note}</span>}
                </p>
                <p class="text-sm leading-relaxed text-muted">{p.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
