---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<span class:list={["seal", className]} style={`--s:${size}px`} role="img" aria-label="徐冠雄" lang="zh-Hant" data-seal>
  <span class="seal-main" aria-hidden="true">徐</span>
  <span class="seal-sub" aria-hidden="true">冠</span>
  <span class="seal-sub" aria-hidden="true">雄</span>
</span>
